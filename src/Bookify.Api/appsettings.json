{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": ""
  },
  "Expiration": {
    "EmailChangeExpirationSeconds": 1800,
    "PasswordRecoveryExpirationSeconds": 600
  },
  "AccountDeletion": {
    "GracePeriodHours": 72
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 80,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 2
    },
    "WriteOperations": {
      "PermitLimit": 15,
      "WindowSeconds": 60
    },
    "Search": {
      "PermitLimit": 45,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 3
    },
    "HealthChecks": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "ServiceBus": ""
  },
  "CompleteBookings": {
    "CronExpression": "0 0 0 * * ?"
  },
  "Booking": {
    "CheckoutSessionTtlMinutes": 30.0,
    "HostApprovalTtlHours": 24.0
  },
  "ServiceBus": {
    "QueueName": "stripe-events"
  }
}