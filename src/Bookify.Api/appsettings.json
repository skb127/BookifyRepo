{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Expiration": {
    "EmailChangeExpirationSeconds": 1800,
    "PasswordRecoveryExpirationSeconds": 600
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 80,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 2
    },
    "WriteOperations": {
      "PermitLimit": 15,
      "WindowSeconds": 60
    },
    "Search": {
      "PermitLimit": 45,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 3
    },
    "HealthChecks": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "CompleteBookings": {
    "CronExpression": "0 0 0 * * ?"
  },
  "NotifyCompletedBookings": {
    "CronExpression": "0 0 0/6 * * ?",
    "BatchSize": 50
  }
}