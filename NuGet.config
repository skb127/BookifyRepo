<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repository-scoped NuGet configuration to satisfy Central Package Management requirements -->
  <packageSources>
    <!-- Clear any inherited sources (e.g., from user-level NuGet.Config) -->
    <clear />
    <!-- Use a single authoritative source -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Map all packages to nuget.org. Add more specific mappings here if you introduce private feeds. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>